<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SkyShift.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test framework and runner, standard dotnet-new-xunit set. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Mocks IVehicleRepository/IVehicleAssignmentRepository/IUnitOfWork for
         the Service-layer (Use Case) tests, required by the course spec. -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Same EF Core version as the rest of the solution (8.0.0). Used only
         by the concurrency test below: it exercises SkyShiftDbContext and
         the real RowVersion optimistic-concurrency token directly, which a
         Moq-mocked repository cannot simulate: Moq mocks an interface's
         behavior, not EF Core's SaveChanges conflict detection. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkyShift.Application\SkyShift.Application.csproj" />
    <ProjectReference Include="..\..\src\SkyShift.Infrastructure\SkyShift.Infrastructure.csproj" />
  </ItemGroup>

</Project>
