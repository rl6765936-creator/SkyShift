<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Trace"
      internalLogFile="${basedir}/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <!-- One rolling file per calendar day under src/SkyShift.Api/logs/
         (three levels up from the bin/Debug/net8.0 runtime basedir), so the
         folder is visible next to the project source rather than buried in
         the build output: readable by a person, per the spec's own framing
         ("a log is a file people read"). -->
    <target xsi:type="File"
            name="logfile"
            fileName="${basedir}/../../../logs/skyshift-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}|CorrelationId=${scopeproperty:CorrelationId}${onexception:${newline}${exception:format=ToString}}" />

    <!-- Keeps console output during local/dev runs: ClearProviders() in
         Program.cs removes the default console provider when NLog takes
         over, so this target replaces it rather than silencing the console. -->
    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}|CorrelationId=${scopeproperty:CorrelationId}" />
  </targets>

  <rules>
    <!-- Framework/EF Core chatter is already filtered by the
         Logging:LogLevel settings in appsettings*.json before it reaches
         any provider; this is the NLog-side mirror of the same policy, in
         case nlog.config is ever consulted on its own. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />

    <!-- Everything else, SkyShift's own code, is allowed through at every
         level; which levels actually get emitted is governed by
         appsettings.json/appsettings.Development.json's Logging:LogLevel
         (Information normally, Debug in Development), per the spec's
         "Debug for development, Information for normal flow, Warning for
         a handled anomaly, Error for a failure". -->
    <logger name="*" minlevel="Trace" writeTo="logfile,console" />
  </rules>
</nlog>
